{
  "schema_version": 1,
  "mode": "gated-live",
  "curator_allow": [
    "index.html",
    "research/**",
    "papers/**",
    "simulations/**",
    "progress/**",
    "methods/**",
    "about/**",
    "changelog/**",
    "harness/**",
    "assets/*.css",
    "assets/*.js",
    "sitemap.xml",
    "robots.txt",
    "404.html"
  ],
  "curator_forbid": [
    ".git/**",
    ".github/**",
    "CNAME",
    "SECURITY.md",
    ".nojekyll"
  ],
  "forbidden_text": [
    "/home/hermes",
    "nimbus-research-log",
    "api_key",
    "authorization: bearer",
    "BEGIN OPENSSH PRIVATE KEY",
    "private journal",
    "raw chat",
    "raw mail",
    "https://github.com/nimbusisland/nimbus-leo-benchmark-reports"
  ],
  "required_public_routes": {
    "/": "index.html",
    "/research/": "research/index.html",
    "/papers/": "papers/index.html",
    "/simulations/": "simulations/index.html",
    "/progress/": "progress/index.html",
    "/methods/": "methods/index.html",
    "/about/": "about/index.html",
    "/changelog/": "changelog/index.html",
    "/harness/": "harness/index.html"
  },
  "content_classes": {
    "activity": [
      "research/index.html",
      "progress/index.html"
    ],
    "source-note": [
      "papers/index.html"
    ],
    "validity-claim": {
      "simulations/index.html": "HOLD"
    }
  }
}
